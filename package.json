{
  "name": "charticulum",
  "version": "1.0.0",
  "description": "**Charticulum**(Chart Your Curriculum)<br /> _The Visual Academic Planner_",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:local": "prisma dev",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "sample:json": "tsx scripts/export-sample.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrus-kw/charticulum.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/cyrus-kw/charticulum/issues"
  },
  "homepage": "https://github.com/cyrus-kw/charticulum#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@xyflow/react": "^12.12.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
